# ── Supabase ─────────────────────────────────────────────────────────────
# Both are safe to expose to the browser. The anon key is protected by RLS,
# which is why the policies in supabase/schema.sql matter so much.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# ── Contact ──────────────────────────────────────────────────────────────
# Country code, no plus sign.
VITE_WHATSAPP_NUMBER=2348012345678
VITE_INSTAGRAM_URL=

# ── Bank transfer details shown at checkout ──────────────────────────────
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NAME=
VITE_BANK_ACCOUNT_NUMBER=

# ── Sister store ─────────────────────────────────────────────────────────
VITE_SWEET_SOIREE_URL=https://thesweetsoiree.vercel.app

# NOTE: there is deliberately no VITE_ADMIN_EMAIL any more. Admin access is
# granted by inserting a row into the `admins` table in Postgres, not by a
# value in a file the browser can read.
